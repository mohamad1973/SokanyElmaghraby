# === دومين المتجر (Next على هوستنجر) ===
# مثال: https://shop.sokany-eg.com   أو https://your-domain.com
NEXTAUTH_URL=https://YOUR_DOMAIN_HERE

# === جلسات (غيّر السر في الإنتاج) ===
NEXTAUTH_SECRET=ضع_هنا_سراً_عشوائياً_طويلاً_32_حرفاً_على_الأقل

# === دخول الأدمن ===
ADMIN_EMAIL=admin@sokany-eg.com
ADMIN_PASSWORD=غيّر_كلمة_المرور_الآن

# === قاعدة بيانات MySQL على هوستنجر ===
# من hPanel → Databases → MySQL:
# DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# === ووردبريس / WooCommerce (يبقى على sokany-eg.com عادة) ===
WOOCOMMERCE_STORE_URL=https://sokany-eg.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxx
WOOCOMMERCE_WEBHOOK_SECRET=

# === بريد فورم التواصل (اختياري) ===
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@sokanyelmaghraby.com
SMTP_PASS=
CONTACT_FROM_EMAIL=info@sokanyelmaghraby.com
CONTACT_TO_EMAIL=info@sokanyelmaghraby.com

# === شحن Bosta (اختياري) ===
BOSTA_API_KEY=
BOSTA_BASE_URL=https://app.bosta.co
BOSTA_WEBHOOK_SECRET=

# === واتساب إشعارات (اختياري) ===
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_RECIPIENT=
WHATSAPP_ORDER_TEMPLATE_NAME=

# === خرائط / فوري (اختياري) ===
GOOGLE_MAPS_API_KEY=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
WOO_FAWRY_PAYMENT_METHOD=fawry

# === تشغيل السيرفر ===
NODE_ENV=production
PORT=3000
