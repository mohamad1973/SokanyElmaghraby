generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CategoryMenuSelection {
  id             Int      @id @default(autoincrement())
  categoryId     Int      @unique
  slug           String
  showInMenu     Boolean  @default(false)
  sortOrder      Int      @default(0)
  parentOverride Int?
  iconUrl        String?  @db.VarChar(500)
  menuTitle      String?  @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([showInMenu])
  @@index([sortOrder])
}

model Shipment {
  id              Int                 @id @default(autoincrement())
  wooOrderId      Int                 @unique
  wooOrderNumber  String
  provider        String
  externalId      String?
  trackingNumber  String?
  status          String              @default("pending")
  codAmount       Decimal             @db.Decimal(10, 2)
  governorate     String
  area            String
  addressLine     String              @db.Text
  receiverName    String
  receiverPhone   String
  lat             Decimal?            @db.Decimal(10, 7)
  lng             Decimal?            @db.Decimal(10, 7)
  rawPayload      Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  assignment      DeliveryAssignment?

  @@index([provider])
  @@index([status])
  @@index([trackingNumber])
}

model Driver {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String        @unique
  email        String?       @unique
  passwordHash String
  isActive     Boolean       @default(true)
  maxOrders    Int           @default(20)
  maxCodValue  Decimal       @default(50000) @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  zones        DriverZone[]
  runs         DeliveryRun[]
}

model DeliveryZone {
  id          Int            @id @default(autoincrement())
  name        String
  governorate String
  parentId    Int?
  polygon     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      DeliveryZone?  @relation("ZoneTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    DeliveryZone[] @relation("ZoneTree")
  drivers     DriverZone[]

  @@index([governorate])
  @@index([parentId])
}

model DriverZone {
  driverId Int
  zoneId   Int
  driver   Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  zone     DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([driverId, zoneId])
}

model DeliveryRun {
  id            Int                  @id @default(autoincrement())
  driverId      Int
  runDate       DateTime             @db.Date
  status        String               @default("draft")
  routePolyline String?              @db.Text
  totalOrders   Int                  @default(0)
  totalCod      Decimal              @default(0) @db.Decimal(12, 2)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  driver        Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignments   DeliveryAssignment[]

  @@unique([driverId, runDate])
  @@index([runDate])
  @@index([status])
}

model DeliveryAssignment {
  id          Int       @id @default(autoincrement())
  runId       Int
  shipmentId  Int       @unique
  sequence    Int       @default(0)
  status      String    @default("pending")
  otpHash     String?
  otpSentAt   DateTime?
  deliveredAt DateTime?
  failReason  String?   @db.Text
  lat         Decimal?  @db.Decimal(10, 7)
  lng         Decimal?  @db.Decimal(10, 7)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  run         DeliveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
}

model CustomerWishlist {
  customerId Int      @id
  entries    Json
  updatedAt  DateTime @updatedAt
}

model SocialProofEvent {
  id          Int      @id @default(autoincrement())
  productName String   @db.VarChar(512)
  productCode String   @default("") @db.VarChar(128)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ——— Group buy / Vendor (ported idea from Tooliano v001; Woo remains sokany-eg.com) ———

model GbUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String
  phone        String?
  email        String?
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendorProfile      GbVendorProfile?
  productSubmissions GbProductSubmission[] @relation("VendorSubmissions")
  groupBuyOrders     GbGroupBuyOrder[]     @relation("BuyerOrders")
}

model GbVendorProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    GbUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName             String
  contactName             String
  phone                   String
  contactEmail            String
  address                 String    @db.Text
  businessType            String
  teamSize                Int       @default(1)
  productTypesDescription String    @db.Text
  status                  String    @default("PENDING")
  adminNote               String?   @db.Text
  reviewedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model GbProductSubmission {
  id                        String    @id @default(cuid())
  vendorId                  String
  vendor                    GbUser    @relation("VendorSubmissions", fields: [vendorId], references: [id], onDelete: Cascade)
  productName               String
  productType               String
  productCondition          String    @default("NEW")
  productDescription        String    @default("") @db.Text
  suggestedQuantity         Int
  suggestedRetailPrice      Float?
  suggestedGroupPrice       Float?
  vendorSettlementUnitPrice Float?
  productImageUrl           String?   @db.VarChar(500)
  status                    String    @default("PENDING")
  adminNote                 String?   @db.Text
  reviewedAt                DateTime?
  wooProductId              Int?
  campaignEndsAt            DateTime?
  dealDurationDays          Int       @default(7)
  reservedQuantity          Int       @default(0)
  publishedOnStore          Boolean   @default(false)
  adminHidden               Boolean   @default(false)
  wooSyncStatus             String    @default("none")
  campaignOutcome           String    @default("ACTIVE")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  groupBuyOrders GbGroupBuyOrder[]

  @@index([status, publishedOnStore, adminHidden])
  @@index([campaignEndsAt])
}

model GbGroupBuyOrder {
  id               String              @id @default(cuid())
  buyerId          String
  buyer            GbUser              @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  submissionId     String
  submission       GbProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  wooCustomerId    Int?
  quantity         Int
  unitGroupPrice   Float
  lineTotal        Float
  depositPercent   Float               @default(5)
  depositAmount    Float
  codAmount        Float
  status           String              @default("PENDING_PAYMENT")
  paymentRef       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([buyerId])
  @@index([submissionId, status])
}

// ——— Customer Service order confirmation (call script) ———

model CsAgent {
  id            Int                    @id @default(autoincrement())
  name          String
  email         String                 @unique
  username      String?                @unique
  passwordHash  String
  isActive      Boolean                @default(true)
  isSupervisor  Boolean                @default(false)
  role          String                 @default("agent")
  roles         String?                @db.VarChar(191)
  phone         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  courierAreas  String?                @db.Text
  confirmations CsOrderConfirmation[]  @relation("AssignedAgent")
  courierOrders CsOrderConfirmation[]  @relation("TemimaCourier")
  monaCourierOrders CsOrderConfirmation[] @relation("MonaCourier")
  assignments   CsOrderAssignment[]    @relation("AssignmentAgent")
  createdAssignments CsOrderAssignment[] @relation("AssignmentCreator")
}

model CsOrderConfirmation {
  id                   Int                 @id @default(autoincrement())
  wooOrderId           Int                 @unique
  wooOrderNumber       String
  status               String              @default("PENDING")
  assignedAgentId      Int?
  assignedAgent        CsAgent?            @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  courierAgentId       Int?
  courierAssignedAt    DateTime?
  courierOutcome       String?             @db.VarChar(16)
  courierRefusalReason String?             @db.Text
  courierAgent         CsAgent?            @relation("TemimaCourier", fields: [courierAgentId], references: [id], onDelete: SetNull)
  customerSnapshot     Json?
  failReason           String?             @db.Text
  shippingCompany      String?
  trackingNumber       String?
  waybillPrinted       Boolean             @default(false)
  depositAmount        Decimal?            @db.Decimal(12, 2)
  depositPaid          Boolean             @default(false)
  depositPayMethod     String?
  depositFromNumber    String?             @db.VarChar(32)
  depositInstapayName  String?             @db.VarChar(191)
  depositToPhone       String?             @db.VarChar(32)
  depositToMethod      String?
  depositPaidAt        DateTime?
  depositProofUrl      String?             @db.VarChar(512)
  depositApprovalStatus String             @default("none") @db.VarChar(32)
  depositApprovalRequestedAt DateTime?
  depositApprovalDecidedAt DateTime?
  depositAgentDecisionSeenAt DateTime?
  handedToCarrier      Boolean             @default(false)
  deliveredToCustomer  Boolean             @default(false)
  customerFollowUp     Boolean             @default(false)
  handedToCarrierAt    DateTime?
  shippingAssignedAt   DateTime?
  salesOrderNumber     String?             @db.VarChar(64)
  invoiceNumber        String?             @db.VarChar(64)
  bostaStatus          String?             @db.VarChar(64)
  bostaShippingFee     Decimal?            @db.Decimal(12, 2)
  bostaSyncedAt        DateTime?
  bostaSyncError       String?             @db.VarChar(255)
  postCancelInvoice    String?             @db.VarChar(16)
  postCancelSystemNo   String?             @db.VarChar(64)
  postCancelRefundPaid Boolean             @default(false)
  postCancelAt         DateTime?
  deliveredToCustomerAt DateTime?
  customerFollowUpAt   DateTime?
  startedAt            DateTime?
  confirmedAt          DateTime?
  confirmationEditedAt DateTime?
  orderTotalDelta      Decimal?            @db.Decimal(12, 2)
  discountApprovalStatus String            @default("none") @db.VarChar(32)
  discountApprovalRequestedAt DateTime?
  discountApprovalDecidedAt DateTime?
  discountAgentDecisionSeenAt DateTime?
  monaCourierId        Int?
  monaCourier          CsAgent?            @relation("MonaCourier", fields: [monaCourierId], references: [id], onDelete: SetNull)
  monaAssignedAt       DateTime?
  monaOutcome          String?             @db.VarChar(16)
  monaRefusalReason    String?             @db.Text
  monaSupervisorResult String?             @db.VarChar(16)
  monaIsLarge          Boolean             @default(false)
  temimaSupervisorResult String?           @db.VarChar(16)
  settlementDepositOverride Decimal?       @db.Decimal(12, 2)
  parentConfirmationId Int?
  fulfillmentKind      String?             @db.VarChar(16)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  answers              CsChecklistAnswer[]
  sheetEdits           CsTemimaSheetEdit[]
  sokanyWaybills       CsSokanyWaybill[]

  @@index([status])
  @@index([assignedAgentId])
  @@index([courierAgentId])
  @@index([monaCourierId])
  @@index([createdAt])
  @@index([shippingCompany])
  @@index([trackingNumber])
  @@index([waybillPrinted])
  @@index([depositApprovalStatus])
  @@index([discountApprovalStatus])
  @@index([parentConfirmationId])
  @@index([fulfillmentKind])
}

model CsChecklistAnswer {
  id             Int                  @id @default(autoincrement())
  confirmationId Int
  confirmation   CsOrderConfirmation  @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  itemKey        String
  confirmed      Boolean              @default(false)
  value          String?              @db.Text
  note           String?              @db.Text
  updatedAt      DateTime             @updatedAt

  @@unique([confirmationId, itemKey])
  @@index([confirmationId])
}

model CsOrderAssignment {
  id                 Int      @id @default(autoincrement())
  agentId            Int
  agent              CsAgent  @relation("AssignmentAgent", fields: [agentId], references: [id], onDelete: Cascade)
  wooOrderNumberFrom Int
  wooOrderNumberTo   Int
  createdById        Int?
  createdBy          CsAgent? @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())

  @@index([agentId])
}

model CsStockAlert {
  id            Int       @id @default(autoincrement())
  productId     Int
  productName   String
  sku           String    @default("")
  model         String?
  stockQuantity Int       @default(0)
  threshold     Int       @default(0)
  whatsappSent  Boolean   @default(false)
  notifiedAt    DateTime  @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId])
  @@index([resolvedAt])
}

model CsReturnEvent {
  id                      Int      @id @default(autoincrement())
  wooOrderId              Int?
  wooOrderNumber          String   @default("")
  productId               Int
  productName             String
  sku                     String   @default("")
  quantity                Int      @default(1)
  reason                  String
  reasonNote              String?  @db.Text
  isManufacturingDefect   Boolean  @default(false)
  source                  String   @default("manual")
  createdByAgentId        Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([productId])
  @@index([createdAt])
  @@index([isManufacturingDefect])
}

model AdminNotification {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(64)
  refId     Int
  title     String   @db.VarChar(255)
  body      Json?
  status    String   @default("unread") @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type, refId])
  @@index([createdAt])
}

model CsCarrierWeek {
  id             Int                 @id @default(autoincrement())
  carrierCompany String              @default("sayed_temima") @db.VarChar(32)
  weekStart      DateTime
  weekEnd        DateTime
  status         String              @default("open") @db.VarChar(16)
  cashDue        Decimal             @default(0) @db.Decimal(12, 2)
  cashPaid       Decimal             @default(0) @db.Decimal(12, 2)
  closedById     Int?
  closedAt       DateTime?
  monthId        Int?
  carryKey       Int                 @default(0)
  sourceWeekId   Int?
  month          CsCarrierMonth?     @relation(fields: [monthId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          CsCarrierWeekLine[]

  @@unique([carrierCompany, weekStart, carryKey], map: "CsCarrierWeek_company_week_carry_key")
  @@index([monthId])
}

model CsCarrierWeekLine {
  id              Int           @id @default(autoincrement())
  weekId          Int
  week            CsCarrierWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  confirmationId  Int
  wooOrderNumber  String        @db.VarChar(64)
  disposition     String        @db.VarChar(24)
  cashAmount      Decimal       @default(0) @db.Decimal(12, 2)
  isLarge         Boolean       @default(false)
  resolvesLineId  Int?
  createdAt       DateTime      @default(now())

  @@index([weekId])
  @@index([confirmationId])
}

model CsCarrierMonth {
  id             Int             @id @default(autoincrement())
  carrierCompany String          @default("sayed_temima") @db.VarChar(32)
  closeDate      DateTime
  shippingTotal  Decimal         @default(0) @db.Decimal(12, 2)
  shippingPaid   Decimal         @default(0) @db.Decimal(12, 2)
  closedById     Int?
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  weeks          CsCarrierWeek[]

  @@unique([carrierCompany, closeDate])
}

model CsCourierCashDay {
  id             Int      @id @default(autoincrement())
  courierAgentId Int
  dayYmd         String   @db.VarChar(10)
  amount         Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([courierAgentId, dayYmd])
}

model CsTemimaSheetCutoff {
  id        Int      @id @default(autoincrement())
  dayYmd    String   @unique @db.VarChar(10)
  minutes   Int
  createdAt DateTime @default(now())
}

model CsTemimaSheetEdit {
  id             Int                 @id @default(autoincrement())
  dayYmd         String              @db.VarChar(10)
  confirmationId Int
  kind           String              @db.VarChar(16)
  createdAt      DateTime            @default(now())
  confirmation   CsOrderConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)

  @@unique([dayYmd, confirmationId])
  @@index([dayYmd])
}

model CsAssignmentRestamp {
  dayYmd    String   @id @db.VarChar(10)
  createdAt DateTime @default(now())
}

model CsOrderSyncState {
  id          Int      @id
  nextPage    Int      @default(1)
  slowPage    Int      @default(1)
  historyDone Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model CsTemimaSheetFreezeDay {
  dayYmd    String   @id @db.VarChar(10)
  createdAt DateTime @default(now())
}

model CsTemimaSheetFreeze {
  dayYmd         String  @db.VarChar(10)
  confirmationId Int
  serial         Int?

  @@id([dayYmd, confirmationId])
  @@index([dayYmd])
}

model CsTemimaSheetPrintCount {
  dayYmd    String   @id @db.VarChar(10)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model CsOrderItemAdd {
  id             Int       @id @default(autoincrement())
  confirmationId Int
  wooProductId   Int
  kind           String    @default("add") @db.VarChar(16)
  productName    String    @db.VarChar(191)
  quantity       Int
  unitPrice      Decimal   @db.Decimal(12, 2)
  lineTotal      Decimal   @db.Decimal(12, 2)
  status         String    @default("pending") @db.VarChar(16)
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?

  @@index([confirmationId])
  @@index([status])
}

model CsMonaCourierAdjust {
  courierAgentId  Int      @id
  collectedAmount Decimal? @db.Decimal(12, 2)
  shippingAmount  Decimal? @db.Decimal(12, 2)
  remittedAmount  Decimal? @db.Decimal(12, 2)
  updatedAt       DateTime @updatedAt
}

model CsMonaCourierRemit {
  id             Int      @id @default(autoincrement())
  courierAgentId Int
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  @@index([courierAgentId])
}

model CsMonaDayAccount {
  courierAgentId  Int
  dayYmd          String   @db.VarChar(10)
  collectedAmount Decimal? @db.Decimal(12, 2)
  shippingAmount  Decimal? @db.Decimal(12, 2)
  remittedAmount  Decimal? @db.Decimal(12, 2)
  updatedAt       DateTime @updatedAt

  @@id([courierAgentId, dayYmd])
}

model CsBostaReturnCapture {
  trackingNumber    String    @id @db.VarChar(64)
  seenDay           String    @db.Char(10)
  kind              String    @db.VarChar(16)
  reasonText        String    @default("") @db.VarChar(191)
  customerName      String    @default("") @db.VarChar(191)
  phone             String    @default("") @db.VarChar(32)
  businessReference String    @default("") @db.VarChar(191)
  wooOrderNumber    String    @default("") @db.VarChar(64)
  confirmationId    Int?
  note              String?   @db.Text
  openedAt          DateTime?
  capturedAt        DateTime  @default(now())

  @@index([seenDay])
}

model CsBostaReturnReview {
  trackingNumber              String    @id @db.VarChar(64)
  condition                   String    @db.VarChar(16)
  defects                     String    @default("") @db.VarChar(64)
  destination                 String    @db.VarChar(32)
  bostaClaim                  Boolean   @default(false)
  usage                       String?   @db.VarChar(16)
  deliveredToMaintenanceAt    DateTime?
  grade                       String?   @db.VarChar(16)
  techNote                    String?   @db.Text
  receivedFromMaintenanceAt   DateTime?
  shelfAt                     DateTime?
  updatedAt                   DateTime  @updatedAt
}

model CsBostaReturnProduct {
  trackingNumber String   @db.VarChar(64)
  productId      Int
  productName    String   @db.VarChar(191)
  productCode    String   @default("") @db.VarChar(64)
  updatedAt      DateTime @updatedAt

  @@id([trackingNumber, productId])
}

model CsWarehouseSheet {
  warehouse String   @id @db.VarChar(20)
  fileName  String   @db.VarChar(255)
  rowsJson  String   @db.MediumText
  updatedAt DateTime @updatedAt
}

model CsCarrier {
  id                 Int      @id @default(autoincrement())
  code               String   @unique @db.VarChar(32)
  nameAr             String   @db.VarChar(191)
  waybillProvider    String   @db.VarChar(16)
  printHubLabel      String   @db.VarChar(191)
  returnAddress      String   @db.Text
  senderName         String   @default("Sokany Elmaghraby") @db.VarChar(191)
  allowOpenPackage   Boolean  @default(true)
  defaultReturnFee   Decimal  @default(75) @db.Decimal(12, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CsSokanyWaybill {
  id             Int                 @id @default(autoincrement())
  tracking       String              @unique @db.VarChar(64)
  confirmationId Int
  confirmation   CsOrderConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  carrierCode    String              @db.VarChar(32)
  kind           String              @db.VarChar(16)
  cod            Decimal             @db.Decimal(12, 2)
  returnFee      Decimal             @db.Decimal(12, 2)
  description    String              @db.Text
  itemsCount     Int                 @default(1)
  snapshot       Json
  invoiceNumber  String?             @db.VarChar(64)
  barcodePayload String              @db.VarChar(64)
  status         String              @default("created") @db.VarChar(24)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([confirmationId])
  @@index([carrierCode])
  @@index([status])
}

model ScCenter {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(191)
  address      String       @db.Text
  governorate  String       @db.VarChar(64)
  phones       String       @db.Text
  headcount    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employees    ScEmployee[]
}

model ScJob {
  id               Int          @id @default(autoincrement())
  title            String       @db.VarChar(191)
  parentId         Int?
  parent           ScJob?       @relation("ScJobTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         ScJob[]      @relation("ScJobTree")
  sortOrder        Int          @default(0)
  responsibilities String       @db.Text
  permissions      String       @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  employees        ScEmployee[]

  @@index([parentId])
}

model ScEmployee {
  id        Int      @id @default(autoincrement())
  centerId  Int
  center    ScCenter @relation(fields: [centerId], references: [id], onDelete: Restrict)
  jobId     Int?
  job       ScJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  agentId   Int      @unique
  name      String   @db.VarChar(191)
  phone     String?  @db.VarChar(32)
  address   String   @db.Text
  photoUrl  String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([centerId])
  @@index([jobId])
}

model ThemeSettings {
  id        String   @id @db.VarChar(64)
  settings  String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminMediaAsset {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(255)
  mimeType  String   @db.VarChar(100)
  size      Int
  purpose   String   @db.VarChar(191)
  data      Bytes
  createdAt DateTime @default(now())

  @@index([purpose])
  @@index([createdAt])
}
