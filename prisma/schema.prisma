generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CategoryMenuSelection {
  id             Int      @id @default(autoincrement())
  categoryId     Int      @unique
  slug           String
  showInMenu     Boolean  @default(false)
  sortOrder      Int      @default(0)
  parentOverride Int?
  iconUrl        String?  @db.VarChar(500)
  menuTitle      String?  @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([showInMenu])
  @@index([sortOrder])
}

model Shipment {
  id              Int                 @id @default(autoincrement())
  wooOrderId      Int                 @unique
  wooOrderNumber  String
  provider        String
  externalId      String?
  trackingNumber  String?
  status          String              @default("pending")
  codAmount       Decimal             @db.Decimal(10, 2)
  governorate     String
  area            String
  addressLine     String              @db.Text
  receiverName    String
  receiverPhone   String
  lat             Decimal?            @db.Decimal(10, 7)
  lng             Decimal?            @db.Decimal(10, 7)
  rawPayload      Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  assignment      DeliveryAssignment?

  @@index([provider])
  @@index([status])
  @@index([trackingNumber])
}

model Driver {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String        @unique
  email        String?       @unique
  passwordHash String
  isActive     Boolean       @default(true)
  maxOrders    Int           @default(20)
  maxCodValue  Decimal       @default(50000) @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  zones        DriverZone[]
  runs         DeliveryRun[]
}

model DeliveryZone {
  id          Int            @id @default(autoincrement())
  name        String
  governorate String
  parentId    Int?
  polygon     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      DeliveryZone?  @relation("ZoneTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    DeliveryZone[] @relation("ZoneTree")
  drivers     DriverZone[]

  @@index([governorate])
  @@index([parentId])
}

model DriverZone {
  driverId Int
  zoneId   Int
  driver   Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  zone     DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([driverId, zoneId])
}

model DeliveryRun {
  id            Int                  @id @default(autoincrement())
  driverId      Int
  runDate       DateTime             @db.Date
  status        String               @default("draft")
  routePolyline String?              @db.Text
  totalOrders   Int                  @default(0)
  totalCod      Decimal              @default(0) @db.Decimal(12, 2)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  driver        Driver               @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignments   DeliveryAssignment[]

  @@unique([driverId, runDate])
  @@index([runDate])
  @@index([status])
}

model DeliveryAssignment {
  id          Int       @id @default(autoincrement())
  runId       Int
  shipmentId  Int       @unique
  sequence    Int       @default(0)
  status      String    @default("pending")
  otpHash     String?
  otpSentAt   DateTime?
  deliveredAt DateTime?
  failReason  String?   @db.Text
  lat         Decimal?  @db.Decimal(10, 7)
  lng         Decimal?  @db.Decimal(10, 7)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  run         DeliveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
}

model CustomerWishlist {
  customerId Int      @id
  entries    Json
  updatedAt  DateTime @updatedAt
}

model SocialProofEvent {
  id          Int      @id @default(autoincrement())
  productName String   @db.VarChar(512)
  productCode String   @default("") @db.VarChar(128)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ——— Group buy / Vendor (ported idea from Tooliano v001; Woo remains sokany-eg.com) ———

model GbUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String
  phone        String?
  email        String?
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendorProfile      GbVendorProfile?
  productSubmissions GbProductSubmission[] @relation("VendorSubmissions")
  groupBuyOrders     GbGroupBuyOrder[]     @relation("BuyerOrders")
}

model GbVendorProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    GbUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName             String
  contactName             String
  phone                   String
  contactEmail            String
  address                 String    @db.Text
  businessType            String
  teamSize                Int       @default(1)
  productTypesDescription String    @db.Text
  status                  String    @default("PENDING")
  adminNote               String?   @db.Text
  reviewedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model GbProductSubmission {
  id                        String    @id @default(cuid())
  vendorId                  String
  vendor                    GbUser    @relation("VendorSubmissions", fields: [vendorId], references: [id], onDelete: Cascade)
  productName               String
  productType               String
  productCondition          String    @default("NEW")
  productDescription        String    @default("") @db.Text
  suggestedQuantity         Int
  suggestedRetailPrice      Float?
  suggestedGroupPrice       Float?
  vendorSettlementUnitPrice Float?
  productImageUrl           String?   @db.VarChar(500)
  status                    String    @default("PENDING")
  adminNote                 String?   @db.Text
  reviewedAt                DateTime?
  wooProductId              Int?
  campaignEndsAt            DateTime?
  dealDurationDays          Int       @default(7)
  reservedQuantity          Int       @default(0)
  publishedOnStore          Boolean   @default(false)
  adminHidden               Boolean   @default(false)
  wooSyncStatus             String    @default("none")
  campaignOutcome           String    @default("ACTIVE")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  groupBuyOrders GbGroupBuyOrder[]

  @@index([status, publishedOnStore, adminHidden])
  @@index([campaignEndsAt])
}

model GbGroupBuyOrder {
  id               String              @id @default(cuid())
  buyerId          String
  buyer            GbUser              @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  submissionId     String
  submission       GbProductSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  wooCustomerId    Int?
  quantity         Int
  unitGroupPrice   Float
  lineTotal        Float
  depositPercent   Float               @default(5)
  depositAmount    Float
  codAmount        Float
  status           String              @default("PENDING_PAYMENT")
  paymentRef       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([buyerId])
  @@index([submissionId, status])
}

// ——— Customer Service order confirmation (call script) ———

model CsAgent {
  id            Int                    @id @default(autoincrement())
  name          String
  email         String                 @unique
  username      String?                @unique
  passwordHash  String
  isActive      Boolean                @default(true)
  isSupervisor  Boolean                @default(false)
  role          String                 @default("agent")
  roles         String?                @db.VarChar(191)
  phone         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  courierAreas  String?                @db.Text
  confirmations CsOrderConfirmation[]  @relation("AssignedAgent")
  courierOrders CsOrderConfirmation[]  @relation("TemimaCourier")
  assignments   CsOrderAssignment[]    @relation("AssignmentAgent")
  createdAssignments CsOrderAssignment[] @relation("AssignmentCreator")
}

model CsOrderConfirmation {
  id                   Int                 @id @default(autoincrement())
  wooOrderId           Int                 @unique
  wooOrderNumber       String
  status               String              @default("PENDING")
  assignedAgentId      Int?
  assignedAgent        CsAgent?            @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  courierAgentId       Int?
  courierAssignedAt    DateTime?
  courierAgent         CsAgent?            @relation("TemimaCourier", fields: [courierAgentId], references: [id], onDelete: SetNull)
  customerSnapshot     Json?
  failReason           String?             @db.Text
  shippingCompany      String?
  trackingNumber       String?
  waybillPrinted       Boolean             @default(false)
  depositAmount        Decimal?            @db.Decimal(12, 2)
  depositPaid          Boolean             @default(false)
  depositPayMethod     String?
  depositFromNumber    String?             @db.VarChar(32)
  depositToPhone       String?             @db.VarChar(32)
  depositToMethod      String?
  depositPaidAt        DateTime?
  depositProofUrl      String?             @db.VarChar(512)
  depositApprovalStatus String             @default("none") @db.VarChar(32)
  depositApprovalRequestedAt DateTime?
  depositApprovalDecidedAt DateTime?
  depositAgentDecisionSeenAt DateTime?
  handedToCarrier      Boolean             @default(false)
  deliveredToCustomer  Boolean             @default(false)
  customerFollowUp     Boolean             @default(false)
  handedToCarrierAt    DateTime?
  shippingAssignedAt   DateTime?
  salesOrderNumber     String?             @db.VarChar(64)
  invoiceNumber        String?             @db.VarChar(64)
  bostaStatus          String?             @db.VarChar(64)
  bostaShippingFee     Decimal?            @db.Decimal(12, 2)
  bostaSyncedAt        DateTime?
  bostaSyncError       String?             @db.VarChar(255)
  postCancelInvoice    String?             @db.VarChar(16)
  postCancelSystemNo   String?             @db.VarChar(64)
  postCancelRefundPaid Boolean             @default(false)
  postCancelAt         DateTime?
  deliveredToCustomerAt DateTime?
  customerFollowUpAt   DateTime?
  startedAt            DateTime?
  confirmedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  answers              CsChecklistAnswer[]

  @@index([status])
  @@index([assignedAgentId])
  @@index([courierAgentId])
  @@index([createdAt])
  @@index([shippingCompany])
  @@index([trackingNumber])
  @@index([waybillPrinted])
  @@index([depositApprovalStatus])
}

model CsChecklistAnswer {
  id             Int                  @id @default(autoincrement())
  confirmationId Int
  confirmation   CsOrderConfirmation  @relation(fields: [confirmationId], references: [id], onDelete: Cascade)
  itemKey        String
  confirmed      Boolean              @default(false)
  value          String?              @db.Text
  note           String?              @db.Text
  updatedAt      DateTime             @updatedAt

  @@unique([confirmationId, itemKey])
  @@index([confirmationId])
}

model CsOrderAssignment {
  id                 Int      @id @default(autoincrement())
  agentId            Int
  agent              CsAgent  @relation("AssignmentAgent", fields: [agentId], references: [id], onDelete: Cascade)
  wooOrderNumberFrom Int
  wooOrderNumberTo   Int
  createdById        Int?
  createdBy          CsAgent? @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())

  @@index([agentId])
}

model CsStockAlert {
  id            Int       @id @default(autoincrement())
  productId     Int
  productName   String
  sku           String    @default("")
  model         String?
  stockQuantity Int       @default(0)
  threshold     Int       @default(0)
  whatsappSent  Boolean   @default(false)
  notifiedAt    DateTime  @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId])
  @@index([resolvedAt])
}

model CsReturnEvent {
  id                      Int      @id @default(autoincrement())
  wooOrderId              Int?
  wooOrderNumber          String   @default("")
  productId               Int
  productName             String
  sku                     String   @default("")
  quantity                Int      @default(1)
  reason                  String
  reasonNote              String?  @db.Text
  isManufacturingDefect   Boolean  @default(false)
  source                  String   @default("manual")
  createdByAgentId        Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([productId])
  @@index([createdAt])
  @@index([isManufacturingDefect])
}

model AdminNotification {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(64)
  refId     Int
  title     String   @db.VarChar(255)
  body      Json?
  status    String   @default("unread") @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type, refId])
  @@index([createdAt])
}

model CsCarrierWeek {
  id             Int                 @id @default(autoincrement())
  carrierCompany String              @default("sayed_temima") @db.VarChar(32)
  weekStart      DateTime
  weekEnd        DateTime
  status         String              @default("open") @db.VarChar(16)
  cashDue        Decimal             @default(0) @db.Decimal(12, 2)
  cashPaid       Decimal             @default(0) @db.Decimal(12, 2)
  closedById     Int?
  closedAt       DateTime?
  monthId        Int?
  month          CsCarrierMonth?     @relation(fields: [monthId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          CsCarrierWeekLine[]

  @@unique([carrierCompany, weekStart])
  @@index([monthId])
}

model CsCarrierWeekLine {
  id              Int           @id @default(autoincrement())
  weekId          Int
  week            CsCarrierWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  confirmationId  Int
  wooOrderNumber  String        @db.VarChar(64)
  disposition     String        @db.VarChar(24)
  cashAmount      Decimal       @default(0) @db.Decimal(12, 2)
  isLarge         Boolean       @default(false)
  resolvesLineId  Int?
  createdAt       DateTime      @default(now())

  @@index([weekId])
  @@index([confirmationId])
}

model CsCarrierMonth {
  id             Int             @id @default(autoincrement())
  carrierCompany String          @default("sayed_temima") @db.VarChar(32)
  closeDate      DateTime
  shippingTotal  Decimal         @default(0) @db.Decimal(12, 2)
  shippingPaid   Decimal         @default(0) @db.Decimal(12, 2)
  closedById     Int?
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  weeks          CsCarrierWeek[]

  @@unique([carrierCompany, closeDate])
}
